# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os dados do seu projeto Supabase.
# Supabase > Project Settings > API
# Sem estas variáveis o site funciona em modo demonstração (dados só no navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-public
